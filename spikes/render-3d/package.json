{
  "name": "bolnitsa-render-3d-probe",
  "productName": "BolnitsaProbe3D",
  "version": "0.0.2",
  "private": true,
  "description": "Проба 3D-вида больницы: Three.js в Electron, модели CC0, авто-бенч и снимки",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "node tools/serve.mjs",
    "bench": "node tools/bench.mjs",
    "assets": "node tools/assets.mjs",
    "electron": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "bench:electron": "npm run build && electron . --bench"
  },
  "dependencies": {},
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/three": "0.186.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.56.1",
    "three": "0.186.1",
    "typescript": "6.0.3"
  },
  "author": "Горница",
  "build": {
    "appId": "games.gornitsa.probe.render3d",
    "productName": "BolnitsaProbe3D",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "publish": null
  }
}
